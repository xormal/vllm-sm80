# A100 (sm_80) поверх боевого набора configs/qwen38-27b-int8-clef.env: только ОТЛИЧИЯ.
# Вольтовские пути, которые на sm_80 не работают или проигрывают, выключены; их заменяют SM80-ядра.
#
# turbomind s884 (tm8) на sm_80 собирается в ПУСТУЮ выдачу MMA (TURBOMIND_ARCH_SM70) -> выкл.
FA2SM70_TM8=0
FA2SM70_TM8_ONLY=0
FA2SM70_DRAFT_TM8=0
# вольтовский gemv/exllama -> наш w8a16_sm80 (cp.async-конвейер + m16n8k16), lm_head туда же
FA2SM70_W8=0
FA2SM80_W8=1
# sm70_f16_gemm (turbomind) на sm_80 не собран
VLLM_SM70_ENABLE_LM_HEAD_FASTPATH=0
# декод A100: блоков = 96 SM (decode_sm80.cuh, по срезу на пару счётчиков): цель 768 = 8 x 96 при qGrp=4
FA2SM70_MAX_SPLITS=96
FA2SM70_SPLIT_FILL=768
# телеметрия vLLM (отказ cpuinfo в фоновом потоке, шум в журнале)
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1
# Своё сведение TP для декода: одно ядро через общую закреплённую память хоста (P2P на паре GPU0-1 не работает).
# Трассы сервера 23.10: медиана 19.7 мкс/вызов против 28.6 у NCCL, около -1.4 мс на шаг декода.
FA2SM70_AR2=1
FA2SM80_AR1=1
# Аргмакс черновика MTP в две ступени на int8-голове (eagle.py, w8a16_sm80: bmax -> topblk -> blk -> candmax):
# грубо по первым 3072 измерениям, точный досчёт 64 n-блоков. A/B 24.10 в одном процессе: +1.5-2 % шагов/с
# (больше при загруженном хосте), приёмка tau та же. Выход не меняется: цель проверяет каждый черновой токен.
FA2SM80_DRAFT_ARGMAX_R=3072
# W12 (qkv внимания): плоскости sm80 + stream-K ядро (w12a16_sm80_sk) вместо вольтовского gemv.
# Холодный L2, форма [7168,5120]: M=4 52.8 мкс против 87.7, M=24 93 против ~193 (распаковка+cuBLAS).
FA2SM80_W12=1
# Размеры захвата CUDA-графов (токены). MTP округляет до кратных 4, и при прежних 1,2,4,8 уже 3 потока шли
# без графа (шаг упирался в хост). До 32 = 8 потоков в полном графе: 6 потоков 294.8 -> 432.7 ток/с
# (+47 %), захват +16 с и 0.84 ГиБ на карту (24.10).
FA2SM80_CG_SIZES=1,2,4,8,12,16,20,24,28,32
# Рычаги боевого с 19.10 (prod/env_boevogo_api_server.txt), которых нет в базовом конфиге репо: исправления стенда
# 18.10 (средние ключей у всех запросов пачки, хвост меты черновика, блоки GDN префикс-кэша под нагрузкой Clef,
# max_tokens=1 без спекулятивных блоков) и Clef: после вытеснения, 34K, 4 записи разом.
FA2SM70_BLKMEAN_ALL=1
FA2SM70_PAD_META_FIX=1
FA2SM70_FREE_UNHASHED_HEAD=1
FA2SM70_NO_SPEC_BLOCKS_MAXTOK1=1
FA2SM70_CLEF_A1=1
FA2SM70_CLEF_NMAX=34816
FA2SM70_CLEF_R=4
# Адаптер Clef целиком на карте (~895 МБ на ранг): на V100 слои 40-63 подкачивались с хоста по PCIe на каждом шаге
# Clef (24 слоя x 37.3 МБ); на A100 (32 ГБ) память есть. Числа побитово те же.
FA2SM70_CLEF_STREAM_FROM=1000
# [24.10] ПРЕФИЛЛ. Кусок 8192 + порог разрежённого префилла 8192 (хвост с вопросом остаётся плотным) -- Clef
# Δp 0.0248, 35/35, dlinnye 50/50. Обмен TP по P2P (после iommu=pt; GPU0/1 на разных мостах -> уровень SYS).
FA2SM70_MAXBATCH=8192
FA2SM70_SPARSE_MINSQ=8192
NCCL_P2P_LEVEL=SYS
# Конвейер строк (fa2sm80_rowpipe), перевозка int12 копировщиком по P2P (x1.35 к NCCL, побитово) и конвейер обмена
# через весь MLP-блок (fa2sm80_blockpipe: простой вычислителя на префилле 8K 710 -> 190 мс). Префилл 8K/32K/131K
# 3093/3242/2867 -> 4725/4804/3820 ток/с, Clef 2826 -> 3974 ток/с, Clef Δp 0.0252, 35/35; декод по GPU-времени тот же.
FA2SM80_ROWPIPE=1
FA2SM80_EXCH_CE=1
FA2SM80_BLOCKPIPE=1
# [24.10] KV 17 блоков по 16384 токена вместо 16 (V100: 10630627328 Б): запрос держит 2 блока (mamba-cache-mode all),
# 16 блоков давали потолок 7 потоков, 17 -- 8 (= верхний захваченный граф 32 токена при MTP k=3). Пачка C=8 456 ток/с;
# Clef Δp 0.0251, 35/35; пик памяти на Clef 34K 31.8 из 32.8 ГБ (карта 32 ГБ; 16 ГиБ KV -- OOM при старте).
FA2SM70_KV_BYTES=11295047936
# [24.10] Свой fp16 GEMM префилла (cg_sm80.cu, CUTLASS sm80 без slice-K): ИНВАРИАНТЕН К ПАЧКЕ -- строка побитово та же
# при любом M и месте в куске (cuBLAS: 27 % элементов расходятся «целиком против кусков»), скорость наравне с cuBLAS;
# таблица конфигураций ~/.cache/vllm-sm80/cgtune.json (bench/tune_cg.py). Инвариантность разрешает план кусков:
# маленький первый (раньше первое сведение), 2048 в середине (GEMM эффективнее), убывающий хвост (короче последнее
# сведение). Префилл 8K/32K/131K 4725/4804/3820 -> 4920/5094/4109, Clef 3974 -> 4212 ток/с, Clef Δp 0.0240.
FA2SM80_CG=1
FA2SM80_BLOCKPIPE_PLAN=512,2048,1024,512
